# Copy this file to .env and fill in your values
# cp .env.example .env

# Inference device: cpu | mps (Apple Silicon) | cuda (NVIDIA)
DEVICE=cpu

# YOLO model: yolo11n.pt (fast/dev) | yolo11s.pt (accurate/prod)
MODEL=yolo11n.pt

# Video source: local file or RTSP stream
# Dev:  data/videos/test.mp4
# Prod: rtsp://username:password@camera_ip:554/stream1
SOURCE=data/videos/test.mp4

# Staff filter — minimum green pixel ratio to flag as staff (0.0 to 1.0)
GREEN_THRESHOLD=0.18

# Tripwire Y position in pixels
# Set to 0 to launch interactive click selector on first frame
# Set to a pixel value (e.g. 240) to skip selector and use directly
LINE_Y=0

# SQLite database path
DB_PATH=data/db/footfall.db

# Show local OpenCV preview window: 1=yes, 0=no (set 0 for headless server)
SHOW_WINDOW=1

# Invert IN/OUT crossing direction: false=top-to-bottom is IN (default)
INVERT_CROSSING=false
